<Window x:Class="Snare.App.Scrolling.ScrollPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snare.App.Scrolling"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ScrollPanelViewModel}"
        x:ClassModifier="internal"
        Title="Scrolling capture"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Height"
        Width="260"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF2E2E2E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dragging the panel's background moves it. -->
    <Border x:Name="Chrome" Background="#F01C1C1C" CornerRadius="8" Padding="10" BorderBrush="#661E88E5" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Scrolling capture" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding HintText}" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
                <Button Content="▶ Start" Command="{Binding StartManualCommand}" Background="#FF1E88E5" ToolTip="Grab while you scroll" />
                <Button Content="Auto-scroll" Command="{Binding StartAutomaticCommand}" ToolTip="Snare scrolls the page to the end" />
                <Button Content="■ Stop" Command="{Binding StopCommand}" Background="#FFC62828" ToolTip="Stop and save (Ctrl+Shift+PrtSc)" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" ToolTip="Stop without saving (Esc)" />
            </WrapPanel>
            <Border Background="#FF0F0F0F" CornerRadius="4" Margin="0,2,0,0" MinHeight="40" MaxHeight="360">
                <Image x:Name="PreviewImage" Stretch="Uniform" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="{Binding HeightText}" Foreground="#CCFFFFFF" FontFamily="Consolas" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Warning}" Foreground="#FFFFB74D" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
