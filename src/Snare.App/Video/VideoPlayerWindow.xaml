<Window x:Class="Snare.App.Video.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snare.App.Video"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:VideoPlayerViewModel}"
        x:ClassModifier="internal"
        Title="{Binding Title}"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="#FF141414"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF2E2E2E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF202020" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="▶" Width="44" ToolTip="Play / pause (Space)" />
                    <Slider x:Name="Seek" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Export GIF…" Command="{Binding ExportGifCommand}" IsEnabled="{Binding CanUseFfmpeg}" ToolTip="The marked range, or the whole video" />
                        <Button Content="Show in folder" Command="{Binding RevealCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Set start" Command="{Binding SetStartCommand}" ToolTip="Mark the current position as the start ([)" />
                        <Button Content="Set end" Command="{Binding SetEndCommand}" ToolTip="Mark the current position as the end (])" />
                        <Button Content="Clear" Command="{Binding ClearRangeCommand}" />
                        <Button Content="Trim to range" Command="{Binding TrimCommand}" IsEnabled="{Binding CanUseFfmpeg}" />
                        <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" Margin="10,0" Foreground="#AAFFFFFF" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding FfmpegHint}" Foreground="#FFFFB74D" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" />
    </DockPanel>
</Window>
