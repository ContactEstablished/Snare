<Window x:Class="Snare.App.Recording.RecordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snare.App.Recording"
        xmlns:core="clr-namespace:Snare.Core.Recording;assembly=Snare.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:RecordSetupViewModel}"
        x:ClassModifier="internal"
        Title="Record video"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#FF1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#AAFFFFFF" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Enter" Command="{Binding RecordCommand}" />
    </Window.InputBindings>

    <StackPanel Margin="22" Width="380">
        <TextBlock Text="Record video" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding OutputText}" Foreground="#99FFFFFF" Margin="0,4,0,0" />

        <TextBlock Text="Microphone" Style="{StaticResource Label}" />
        <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" />
        <CheckBox Content="Record system audio (what you hear)" IsChecked="{Binding SystemAudio}" />

        <TextBlock Text="Webcam" Style="{StaticResource Label}" />
        <ComboBox ItemsSource="{Binding Webcams}" SelectedItem="{Binding SelectedWebcam}" DisplayMemberPath="Name" />
        <Grid Visibility="{Binding HasWebcam, Converter={StaticResource Visible}}" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- A schematic of the video with the webcam corner; click a corner to move it there. -->
            <Border Width="160" Height="90" Background="#FF2B2B2B" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Button Width="44" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" ToolTip="Top left"
                            Command="{Binding SetCornerCommand}" CommandParameter="{x:Static core:WebcamCorner.TopLeft}" x:Name="TopLeft" />
                    <Button Width="44" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" ToolTip="Top right"
                            Command="{Binding SetCornerCommand}" CommandParameter="{x:Static core:WebcamCorner.TopRight}" x:Name="TopRight" />
                    <Button Width="44" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" ToolTip="Bottom left"
                            Command="{Binding SetCornerCommand}" CommandParameter="{x:Static core:WebcamCorner.BottomLeft}" x:Name="BottomLeft" />
                    <Button Width="44" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" ToolTip="Bottom right"
                            Command="{Binding SetCornerCommand}" CommandParameter="{x:Static core:WebcamCorner.BottomRight}" x:Name="BottomRight" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding WebcamCorner, StringFormat='Corner: {0}'}" />
                <TextBlock Text="{Binding WebcamSizePercent, StringFormat='Size: {0}% of the height'}" Margin="0,8,0,2" />
                <Slider Minimum="10" Maximum="40" Value="{Binding WebcamSizePercent}" IsSnapToTickEnabled="True" TickFrequency="5" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Video" Style="{StaticResource Label}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="30 fps" IsChecked="{Binding SixtyFps, Converter={x:Static local:RecordSetupWindow.Not}}" GroupName="Fps" />
            <RadioButton Content="60 fps" IsChecked="{Binding SixtyFps}" GroupName="Fps" />
        </StackPanel>
        <CheckBox Content="Highlight mouse clicks" IsChecked="{Binding HighlightClicks}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="● Record" Command="{Binding RecordCommand}" Padding="16,6" IsDefault="True" Background="#FFC62828" Foreground="White" />
        </StackPanel>
        <TextBlock Text="Recording starts after a 3-second countdown. Press Shift+PrtSc to stop." Foreground="#77FFFFFF" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
