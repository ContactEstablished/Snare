<Window x:Class="Snare.App.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snare.App.Editor"
        xmlns:editing="clr-namespace:Snare.Rendering.Editing;assembly=Snare.Rendering"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:EditorViewModel}"
        x:ClassModifier="internal"
        Title="{Binding Title}"
        Width="1500" Height="950"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="Chip" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF00B4FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Chip}">
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Command" Value="{Binding SetToolCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Chip}" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
        </Style>
        <DataTemplate x:Key="Swatch">
            <Button Width="20" Height="20" Margin="2,0" Padding="0" Background="{Binding}" ToolTip="{Binding}"
                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#55FFFFFF" BorderThickness="1" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Tools and actions -->
        <Border DockPanel.Dock="Top" Background="#FF242424" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="ToolButtons">
                    <RadioButton Tag="{x:Static editing:EditorTool.Select}" Content="Select" ToolTip="Select, move, resize (V)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Arrow}" Content="Arrow" ToolTip="Arrow (A)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Line}" Content="Line" ToolTip="Line (L)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Rectangle}" Content="Rect" ToolTip="Rectangle (R)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Ellipse}" Content="Ellipse" ToolTip="Ellipse (E)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Highlighter}" Content="Highlight" ToolTip="Highlighter (H)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Pen}" Content="Pen" ToolTip="Pen (P)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Text}" Content="Text" ToolTip="Text (T)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Step}" Content="Step" ToolTip="Step numbers (N)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Callout}" Content="Callout" ToolTip="Callout: drag the bubble, type, then drag its tail (K)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Redact}" Content="Redact" ToolTip="Redact: solid, secure (D)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Blur}" Content="Blur" ToolTip="Blur: obscures, not secure (B)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Pixelate}" Content="Pixelate" ToolTip="Pixelate: obscures, not secure (X)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Eyedropper}" Content="Pick" ToolTip="Eyedropper (I)" />
                    <RadioButton Tag="{x:Static editing:EditorTool.Crop}" Content="Crop" ToolTip="Crop (C), Enter to apply" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Ctrl+Z" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="Ctrl+Y" />
                    <Button Content="Copy" Command="{Binding CopyImageCommand}" ToolTip="Copy the image (Ctrl+Shift+C)" />
                    <Button Content="Save" Command="{Binding SaveCommand}" ToolTip="Update the library image (Ctrl+S)" />
                    <Button Content="Save As…" Command="{Binding SaveAsCommand}" ToolTip="Save a PNG or JPG copy (Ctrl+Shift+S)" />
                    <Border x:Name="DragHandle" Background="#22FFFFFF" CornerRadius="4" Padding="9,5" Margin="4,0" Cursor="Hand"
                            ToolTip="Drag the image into another app">
                        <TextBlock Text="⇲ Drag" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Style panel for the current tool or selection -->
        <Border DockPanel.Dock="Top" Background="#FF202020" Padding="10,5" BorderBrush="#FF2E2E2E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" MinHeight="28">
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsColor, Converter={StaticResource Visible}}">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Color}" BorderBrush="White" BorderThickness="2" ToolTip="{Binding Color}" />
                    <ItemsControl ItemsSource="{Binding Palette}" ItemTemplate="{StaticResource Swatch}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="Recent" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding RecentColors}" ItemTemplate="{StaticResource Swatch}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsWidth, Converter={StaticResource Visible}}">
                    <TextBlock Text="Size" Style="{StaticResource Label}" />
                    <Slider Minimum="1" Maximum="48" Value="{Binding StrokeWidth}" />
                    <TextBlock Text="{Binding StrokeWidth}" Width="24" VerticalAlignment="Center" Margin="4,0" />
                </StackPanel>
                <CheckBox Content="Fill" IsChecked="{Binding Filled}" Visibility="{Binding ShowsFill, Converter={StaticResource Visible}}" />
                <CheckBox Content="Open head" IsChecked="{Binding OpenArrowHead}" Visibility="{Binding ShowsArrowHead, Converter={StaticResource Visible}}" />
                <CheckBox Content="Dashed" IsChecked="{Binding Dashed}" Visibility="{Binding ShowsDashed, Converter={StaticResource Visible}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsText, Converter={StaticResource Visible}}">
                    <TextBlock Text="Font size" Style="{StaticResource Label}" />
                    <Slider Minimum="8" Maximum="120" Value="{Binding FontSize}" />
                    <TextBlock Text="{Binding FontSize}" Width="28" VerticalAlignment="Center" Margin="4,0" />
                    <CheckBox Content="Bold" IsChecked="{Binding Bold}" />
                    <CheckBox Content="Background" IsChecked="{Binding TextBackground}" Visibility="{Binding ShowsTextBackground, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsStrength, Converter={StaticResource Visible}}">
                    <TextBlock Text="Strength" Style="{StaticResource Label}" />
                    <Slider Minimum="2" Maximum="40" Value="{Binding Strength}" />
                    <TextBlock Text="{Binding Strength}" Width="24" VerticalAlignment="Center" Margin="4,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCropping, Converter={StaticResource Visible}}">
                    <Button Content="Apply crop" Command="{Binding ApplyCropCommand}" ToolTip="Enter" />
                </StackPanel>
                <Button Content="Remove crop" Command="{Binding ClearCropCommand}" Visibility="{Binding HasCrop, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <!-- Redaction banners -->
        <Border DockPanel.Dock="Top" Background="#FF5D4100" Padding="12,5"
                Visibility="{Binding HasObscuringRedaction, Converter={StaticResource Visible}}">
            <TextBlock Text="Blur and pixelate obscure text but don't secure it: blurred text can sometimes be recovered. Use Redact for anything sensitive." TextWrapping="Wrap" />
        </Border>
        <Border DockPanel.Dock="Top" Background="#FF26324A" Padding="12,4"
                Visibility="{Binding SuggestDiscardOriginal, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Discard original…" Command="{Binding DiscardOriginalCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="The library still keeps the unredacted original so you can re-edit. Discard it to make the redaction permanent." />
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Background="#FF242424" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomText}" Foreground="#AAFFFFFF" Margin="16,0,0,0" ToolTip="Ctrl+wheel zoom · Ctrl+0 fit · Ctrl+1 100% · Space+drag pan" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="#AAFFFFFF" Margin="16,0,0,0" />
                <TextBlock Text="{Binding Status}" Foreground="#AAFFFFFF" />
            </DockPanel>
        </Border>

        <Grid x:Name="CanvasHost">
            <Canvas x:Name="Overlay" IsHitTestVisible="True" Background="{x:Null}">
                <TextBox x:Name="TextEditor" Visibility="Collapsed" AcceptsReturn="True" MinWidth="80"
                         BorderThickness="1" BorderBrush="#FF00B4FF" Background="#AA000000" Padding="2" />
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
