<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SnareWindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Snare</AssemblyName>
    <RootNamespace>Snare.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snare.Capture\Snare.Capture.csproj" />
    <ProjectReference Include="..\Snare.Core\Snare.Core.csproj" />
    <ProjectReference Include="..\Snare.Interop\Snare.Interop.csproj" />
    <ProjectReference Include="..\Snare.Library\Snare.Library.csproj" />
    <ProjectReference Include="..\Snare.Recording\Snare.Recording.csproj" />
    <ProjectReference Include="..\Snare.Rendering\Snare.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snare.App.Tests" />
  </ItemGroup>

</Project>
