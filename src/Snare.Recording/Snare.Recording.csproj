<Project Sdk="Microsoft.NET.Sdk">

  <!-- ScreenRecorderLib is native (C++/CLI) and x64 only; the whole solution builds x64 for it. -->
  <PropertyGroup>
    <TargetFramework>$(SnareWindowsTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ScreenRecorderLib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snare.Core\Snare.Core.csproj" />
    <ProjectReference Include="..\Snare.Interop\Snare.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snare.Recording.Tests" />
  </ItemGroup>

</Project>
