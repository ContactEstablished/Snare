<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SnareWindowsTargetFramework)</TargetFramework>
    <!-- Per-Monitor V2 like the app, so explicit real-desktop tests see physical pixels. -->
    <ApplicationManifest>..\..\src\Snare.App\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Snare.Capture\Snare.Capture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded scrolling sequences; re-record with tools/scroll-fixture/record.mjs. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
